# API server config
# Render will set PORT automatically; local default is 5050.
PORT=5050

# Rate limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=600000

# LeakOSINT upstream
LEAKOSINT_API_URL=https://leakosintapi.com/
LEAKOSINT_TOKEN=YOUR_TOKEN_HERE
LEAKOSINT_LIMIT=100
LEAKOSINT_LANG=en

# CORS (comma-separated)
# Example (local + Cloudflare Pages):
# CORS_ORIGINS=http://localhost:3000,https://your-site.pages.dev
CORS_ORIGINS=http://localhost:3000
